DATABASE_URL="postgresql://calendar_user:calendar_password@localhost:5432/calendar_app?schema=public"
NEXTAUTH_SECRET="replace_with_a_long_random_secret"
NEXTAUTH_URL="https://tu-dominio.com"
OPENAI_API_KEY="replace_with_openai_key"
# Un admin puede sustituir esta clave desde /admin sin editar el .env.

# Google OAuth (consola de Google Cloud → APIs y servicios → Credenciales)
# Tipo "Aplicación web". URI de redirección autorizada:
#   {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="replace_with_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="replace_with_google_oauth_client_secret"


# Resend (correos: confirmación de eventos y recordatorios del dueño)
RESEND_API_KEY="re_xxxxxxxx"
# Nombre visible y correo en tu dominio verificado (mismo formato que Resend usa con resend.dev):
# RESEND_FROM_EMAIL="Calendario <calendar@dvguzman.com>"
RESEND_FROM_EMAIL="Calendario <calendar@dvguzman.com>"

# Opcional: enlace en el pie de los correos
PUBLIC_APP_URL="https://tu-dominio.com"

# Cron de recordatorios (GET /api/cron/event-reminders con Authorization: Bearer ...)
CRON_SECRET="replace_with_a_long_random_secret"

# Zona horaria para “hoy” en recordatorios (por defecto Europe/Madrid)
EVENT_TIMEZONE="Europe/Madrid"
