// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/**
 * Categorías para los contactos rápidos guardados por la IA o por el usuario.
 */
enum ContactCategory {
  FAMILY
  FRIEND
  WORK
  OTHER
}

model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  /**
   * Null cuando la cuenta se creó solo con Google y aún no definió contraseña.
   */
  passwordHash           String?
  name                   String?
  role                   Role                 @default(USER)
  /**
   * Acceso al chat, parseo en lenguaje natural y transcripción. Lo activa un
   * administrador; por defecto nadie (salvo el seed de admin) lo tiene.
   */
  aiEnabled              Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  /**
   * Token público (random URL-safe) usado para suscribir el calendario por
   * `webcal://` o descargar el .ics sin sesión. Se puede regenerar desde
   * Ajustes para invalidar suscripciones antiguas.
   */
  calendarFeedToken      String?              @unique
  events                 Event[]
  friendRequestsSent     FriendRequest[]      @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[]      @relation("FriendRequestTo")
  adminNotes             AdminNote[]
  contacts               Contact[]
  passwordResetTokens    PasswordResetToken[]
  apiKeys                ApiKey[]
  googleCalendarLink     GoogleCalendarLink?
  googleDeletions        GoogleDeletion[]
}

/**
 * Códigos de un solo uso para «Olvidé mi contraseña». Se guarda el hash
 * del código (no el texto), expira en pocos minutos y queda inutilizable
 * tras consumirse o tras varios intentos fallidos.
 */
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  /**
   * Hash bcrypt del código numérico de 6 dígitos enviado por email.
   */
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  /**
   * Conteo de intentos fallidos contra este token (bloqueo por fuerza bruta).
   */
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/**
 * Llaves de API por usuario: dejan que un programa entre a la cuenta sin la
 * contraseña —Jarvis, un script, otra máquina— y sin que caduque cada dos meses
 * como el JWT de la app móvil. Se revocan de una en una desde Ajustes, así que
 * quitarle el acceso a un programa no obliga a cambiar la contraseña ni echa
 * fuera al teléfono.
 * Se guarda el hash y nunca el texto: la llave se enseña una sola vez, cuando se
 * crea. Si se pierde, se revoca y se hace otra.
 */
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  /**
   * Cómo la reconoce su dueño en la lista ("Jarvis", "portátil del trabajo").
   */
  name       String
  /**
   * SHA-256 del secreto, en hexadecimal. Hash rápido a propósito y no bcrypt:
   * la llave son 32 bytes al azar, así que no hay diccionario que la adivine, y
   * bcrypt añadiría cien milisegundos a CADA petición de la API.
   */
  keyHash    String    @unique
  /**
   * Los últimos cuatro caracteres, para distinguir dos llaves en la lista sin
   * que enseñarlas sirva para entrar.
   */
  last4      String
  /**
   * Cuándo se usó por última vez. Se actualiza como mucho una vez cada cinco
   * minutos: saber el día que una llave dejó de usarse vale para revocarla,
   * escribir en la base en cada petición no vale para nada.
   */
  lastUsedAt DateTime?
  revokedAt  DateTime?
  /**
   * Caducidad opcional. Null = no caduca; es lo normal para un servicio que
   * tiene que seguir funcionando sin que nadie se acuerde de renovarlo.
   */
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/**
 * Notas Markdown gestionadas por administradores (sección /notas).
 */
model AdminNote {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model FriendRequest {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Event {
  id                     String    @id @default(cuid())
  userId                 String
  title                  String
  description            String?
  location               String?
  startAt                DateTime
  endAt                  DateTime
  color                  String    @default("bg-blue-500")
  attendees              String[]  @default([])
  /**
   * Usuarios amigos incluidos en el evento (solo IDs de amistad aceptada).
   */
  participantUserIds     String[]  @default([])
  organizer              String?
  /**
   * Si ya se envió el recordatorio por correo el día del evento (cron).
   */
  reminderEmailSentAt    DateTime?
  /**
   * Aviso "X minutos antes" configurable por el usuario (en minutos). Null = sin
   * recordatorio adicional al del día. Valores típicos: 5, 15, 30, 60, 120, 1440.
   */
  reminderMinutesBefore  Int?
  /**
   * Si ya se envió el recordatorio "X minutos antes" para este evento. Evita
   * dobles envíos cuando el cron corre cada 5 minutos.
   */
  reminderUpcomingSentAt DateTime?
  /**
   * Si es false, no se envían correos de recordatorio (ni el del día a las 8:00
   * ni el aviso "X minutos antes"). El usuario puede volver a activarlos.
   */
  emailRemindersEnabled  Boolean   @default(true)
  /**
   * El mismo evento en Google Calendar, si está sincronizado.
   */
  googleEventId          String?
  /**
   * Cuándo se dejó igualado con Google. Compararlo con `updatedAt` es lo que
   * distingue «esto lo tocó el usuario y hay que subirlo» de «esto acaba de
   * bajar de Google»: sin esa marca, cada bajada se volvería a subir y cada
   * subida a bajar, en bucle.
   * Se escribe con SQL directo (`SET "googleSyncedAt" = "updatedAt"`) porque
   * `@updatedAt` lo aplica el cliente de Prisma: escribirlo por el camino normal
   * volvería a mover `updatedAt` y el evento seguiría pareciendo sucio para siempre.
   */
  googleSyncedAt         DateTime?
  /**
   * Instancia de un evento recurrente de Google («todos los martes»). Se ve y se
   * consulta aquí, pero no se sube: devolver el cambio de una repetición suelta
   * a su serie es de las cosas que rompen el calendario del otro lado.
   */
  googleRecurring        Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId, startAt])
  @@index([reminderUpcomingSentAt, startAt])
  @@index([userId, googleSyncedAt])
}

/**
 * El permiso de un usuario para que la aplicación entre a su Google Calendar.
 * Uno por persona: sincronizar con dos calendarios de Google a la vez es una
 * función distinta y bastante más cara de razonar (¿en cuál se crea lo nuevo?),
 * y nadie la ha pedido.
 * El refresh token se guarda cifrado. Es la llave que abre el calendario de una
 * persona durante meses; en claro, una copia de seguridad de la base de datos se
 * convierte en una copia de las agendas de todo el mundo.
 */
model GoogleCalendarLink {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /**
   * Correo de la cuenta de Google conectada, para que se vea cuál es en Ajustes.
   */
  googleEmail          String
  /**
   * Cifrado con secret-box (AES-256-GCM). Nunca sale de aquí.
   */
  refreshToken         String
  /**
   * El de acceso dura una hora. Se guarda cifrado y se reutiliza en vez de pedir
   * uno nuevo en cada pasada del cron, que serían doce peticiones por hora y por
   * persona para nada.
   */
  accessToken          String?
  accessTokenExpiresAt DateTime?
  /**
   * Qué calendario de Google. "primary" es el principal de la cuenta.
   */
  calendarId           String    @default("primary")
  /**
   * El testigo de la última sincronización: con él, Google devuelve solo lo que
   * cambió desde entonces en vez de la agenda entera. Cuando caduca (410), se
   * hace una pasada completa y se empieza otro.
   */
  syncToken            String?
  syncEnabled          Boolean   @default(true)
  lastSyncAt           DateTime?
  /**
   * El último fallo, para poder enseñarlo en Ajustes. Una sincronización que se
   * cae en silencio es peor que una que no existe: el calendario parece bien y
   * está mintiendo.
   */
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Un evento borrado aquí que todavía hay que borrar en Google.
 * Hace falta una lápida porque al borrar la fila desaparece con ella el
 * `googleEventId`, y sin él nadie sabe qué había que borrar allá. Llamar a
 * Google en el mismo momento del borrado tampoco basta: si la petición falla
 * —red, token caducado— el evento se queda vivo en Google para siempre y nadie
 * se entera.
 */
model GoogleDeletion {
  id            String   @id @default(cuid())
  userId        String
  googleEventId String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId])
}

/**
 * Contactos rápidos por usuario. Usado por la IA para inferir el calendario
 * (lane) cuando un evento menciona a una persona conocida (p. ej. «cumpleaños
 * de Benjamin» → Familia). Se sugieren al usuario para guardarse al vuelo.
 */
model Contact {
  id             String          @id @default(cuid())
  userId         String
  name           String
  /**
   * Versión normalizada (lowercase, sin acentos, espacios colapsados) para búsqueda.
   */
  normalizedName String
  category       ContactCategory
  /**
   * Relación opcional libre escrita por el usuario o sugerida por la IA («hermano», «compañero», «amiga»).
   */
  relation       String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([userId])
}

/**
 * Ajustes globales de la instancia (una fila por clave).
 * `openai_api_key` guarda la clave cifrada; si no hay fila, se usa OPENAI_API_KEY del entorno.
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * Auditoría de intentos de login (web NextAuth y API móvil).
 */
model AuthLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  channel   String
  email     String?
  ip        String?
  userAgent String?
  success   Boolean
  reason    String
  detail    String?

  @@index([createdAt])
  @@index([email])
  @@index([success])
}
